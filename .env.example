# Copy to .env and adjust. Never commit .env.

# --- Database ---
POSTGRES_DB=fuelcast
POSTGRES_USER=fuelcast
POSTGRES_PASSWORD=change-me

# How the backend reaches the DB (service name "db" inside Docker network)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fuelcast
SPRING_DATASOURCE_USERNAME=fuelcast
SPRING_DATASOURCE_PASSWORD=change-me

# --- Ingestion ---
# Pull today's snapshot on boot, then daily via cron.
INGESTION_RUN_ON_STARTUP=true
# Second Minute Hour DoM Month DoW  (Europe/Rome). Default: 09:30 daily.
INGESTION_CRON=0 30 9 * * *
# Where raw CSVs are archived (mounted volume in Docker).
APP_INGESTION_ARCHIVE_DIR=/app/data/raw

# --- Historical backfill (one-off; leave disabled for normal runs) ---
# Enable and set a quarter range to backfill from the MIMIT archive, e.g.:
#   BACKFILL_ENABLED=true BACKFILL_FROM=2024-3 BACKFILL_TO=2026-2
BACKFILL_ENABLED=false
BACKFILL_FROM=
BACKFILL_TO=
BACKFILL_EXIT_WHEN_DONE=false

# --- Production deploy (docker-compose.prod.yml) ---
# Cloudflare Tunnel token from the Zero Trust dashboard (Networks → Tunnels).
# Required only for the prod overlay; the public hostname → http://frontend:80
# route is configured in the dashboard. See docs/05-deployment.md.
CLOUDFLARE_TUNNEL_TOKEN=
