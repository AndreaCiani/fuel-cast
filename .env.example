# Copy to .env and adjust. Never commit .env.

# --- Database ---
POSTGRES_DB=fuelcast
POSTGRES_USER=fuelcast
POSTGRES_PASSWORD=change-me

# How the backend reaches the DB (service name "db" inside Docker network)
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/fuelcast
SPRING_DATASOURCE_USERNAME=fuelcast
SPRING_DATASOURCE_PASSWORD=change-me

# --- Ingestion ---
# Pull today's snapshot on boot, then daily via cron.
INGESTION_RUN_ON_STARTUP=true
# Second Minute Hour DoM Month DoW  (Europe/Rome). Default: 09:30 daily.
INGESTION_CRON=0 30 9 * * *
# Where raw CSVs are archived (mounted volume in Docker).
APP_INGESTION_ARCHIVE_DIR=/app/data/raw
